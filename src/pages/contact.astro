---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReservationForm from '../components/ReservationForm.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import hotel from '../data/hotel.json';
---

<BaseLayout
  title="Contact"
  description={`Contactez ${hotel.name} à ${hotel.city} via WhatsApp ou le formulaire de demande.`}
>
  <section class="bg-ocean text-foam">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-28 sm:px-6 sm:pb-16">
      <p class="text-xs font-medium uppercase tracking-[0.28em] text-sand/80">{hotel.city}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Contact & réservation</h1>
      <p class="mt-4 max-w-2xl text-foam/80">
        Pas de moteur de réservation en ligne : on finalise tout sur WhatsApp, simplement.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="reveal">
        <h2 class="text-2xl text-ocean">Coordonnées</h2>
        <ul class="mt-5 space-y-4 text-ocean/85">
          <li>
            <span class="block text-sm font-medium text-ocean/55">Adresse</span>
            {hotel.address}
          </li>
          <li>
            <span class="block text-sm font-medium text-ocean/55">Téléphone / WhatsApp</span>
            <a
              class="font-semibold text-lagoon hover:underline"
              href={`https://wa.me/${hotel.whatsapp}?text=${encodeURIComponent(hotel.whatsappPrefill)}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {hotel.phone}
            </a>
          </li>
          <li>
            <span class="block text-sm font-medium text-ocean/55">E-mail</span>
            <a class="font-semibold text-lagoon hover:underline" href={`mailto:${hotel.email}`}>
              {hotel.email}
            </a>
          </li>
          <li>
            <span class="block text-sm font-medium text-ocean/55">Horaires</span>
            {hotel.hours}
          </li>
        </ul>

        <div class="mt-6">
          <WhatsAppButton label="Écrire maintenant" message={hotel.whatsappPrefill} />
        </div>

        <div class="mt-8 rounded-2xl border border-terracotta/40 bg-terracotta/10 px-4 py-3 text-sm text-ocean">
          <strong>DÉMONSTRATION :</strong> {hotel.demoNotice}
        </div>
      </div>

      <div class="reveal">
        <h2 class="mb-4 text-2xl text-ocean">Demande de réservation</h2>
        <ReservationForm />
      </div>
    </div>
  </section>
</BaseLayout>
