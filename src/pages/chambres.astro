---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoomCard from '../components/RoomCard.astro';
import hotel from '../data/hotel.json';
---

<BaseLayout
  title="Chambres"
  description={`Chambres de l’${hotel.name} à ${hotel.city} — Standard, Confort et Famille. Réservation WhatsApp.`}
>
  <section class="bg-ocean text-foam">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-28 sm:px-6 sm:pb-16">
      <p class="text-xs font-medium uppercase tracking-[0.28em] text-sand/80">{hotel.city}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Nos chambres</h1>
      <p class="mt-4 max-w-2xl text-foam/80">
        Trois formules claires. Chaque bouton WhatsApp ouvre un message déjà prérempli pour la chambre choisie.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {hotel.rooms.map((room) => (
        <div class="reveal">
          <RoomCard room={room} />
        </div>
      ))}
    </div>
    <p class="reveal mt-10 text-center text-sm text-ocean/55">
      Check-in {hotel.checkIn} · Check-out {hotel.checkOut} · Tarifs en {hotel.rooms[0].currency}, à confirmer
    </p>
  </section>
</BaseLayout>
