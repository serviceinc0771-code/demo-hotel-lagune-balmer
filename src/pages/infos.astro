---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import hotel from '../data/hotel.json';
---

<BaseLayout
  title="Infos pratiques"
  description={`Infos pratiques — ${hotel.name}, ${hotel.city}. Arrivée, paiement, accès.`}
>
  <section class="bg-ocean text-foam">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-28 sm:px-6 sm:pb-16">
      <p class="text-xs font-medium uppercase tracking-[0.28em] text-sand/80">{hotel.city}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Infos pratiques</h1>
      <p class="mt-4 max-w-2xl text-foam/80">
        Tout ce qu’il faut savoir avant votre séjour à {hotel.city}.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid gap-6 md:grid-cols-2">
      {hotel.practical.map((item) => (
        <div class="reveal rounded-2xl border border-border bg-foam p-6">
          <h2 class="text-xl text-ocean">{item.title}</h2>
          <p class="mt-2 leading-relaxed text-ocean/80">{item.text}</p>
        </div>
      ))}
    </div>

    <div class="reveal mt-12">
      <h2 class="text-2xl text-ocean sm:text-3xl">Services</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {hotel.amenities.map((a) => (
          <li class="rounded-2xl border border-border bg-foam px-4 py-4">
            <span class="font-medium text-ocean">{a.title}</span>
            <span class="mt-0.5 block text-sm text-ocean/60">{a.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="reveal mt-12 flex flex-wrap items-center gap-4">
      <WhatsAppButton label="Poser une question" message={hotel.whatsappPrefill} />
      <a href="/contact" class="font-semibold text-lagoon underline-offset-4 hover:underline">
        Page contact →
      </a>
    </div>
  </section>
</BaseLayout>
