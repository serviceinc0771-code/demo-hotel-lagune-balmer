---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RoomCard from '../components/RoomCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import hotel from '../data/hotel.json';

const trust = ['San-Pédro', 'plage', 'WiFi', 'MoMo', 'SLA'];

const steps = [
  {
    n: '01',
    title: 'Choisissez votre chambre',
    text: 'Standard, Confort ou Famille — tarifs clairs, en FCFA, à confirmer.',
  },
  {
    n: '02',
    title: 'Écrivez-nous sur WhatsApp',
    text: 'Un message prérempli s’ouvre : dates, chambre, questions. Réponse rapide.',
  },
  {
    n: '03',
    title: 'Confirmez et payez sur place',
    text: 'Espèces ou Mobile Money (Orange / MTN / Wave). Pas de paiement sur le site.',
  },
];
---

<BaseLayout
  title="Accueil"
  description={`${hotel.name} à ${hotel.city} — chambres confortables au bord de la lagune. Réservation via WhatsApp.`}
>
  <Hero />

  <section class="bg-lagoon text-foam" aria-label="Confiance">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-3 gap-y-2 px-4 py-3.5 sm:gap-x-4">
      {trust.map((item, i) => (
        <>
          {i > 0 && (
            <span class="text-foam/35" aria-hidden="true">·</span>
          )}
          <span class="text-sm tracking-wide sm:text-[15px]">{item}</span>
        </>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="reveal mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-lagoon">Chambres</p>
        <h2 class="mt-2 text-3xl text-ocean sm:text-4xl">Trois chambres, des prix nets</h2>
        <p class="mt-2 max-w-xl text-ocean/70">Tarifs indicatifs en FCFA, à confirmer sur WhatsApp.</p>
      </div>
      <a href="/chambres" class="text-sm font-semibold text-lagoon underline-offset-4 hover:underline">
        Toutes les chambres →
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {hotel.rooms.map((room) => (
        <div class="reveal">
          <RoomCard room={room} />
        </div>
      ))}
    </div>
  </section>

  <section class="bg-lagoon/95 text-foam">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-20">
      <div class="reveal overflow-hidden rounded-2xl border border-white/10">
        <img
          src="/images/hero.svg"
          alt="Plage et lagon, lumière du soir"
          width="1400"
          height="900"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="reveal">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sand">Le lieu</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Quartier Balmer, au bord de la lagune</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-foam/80">
          À San-Pédro, on arrive par la lagune avant la mer. L’{hotel.name} est une halte simple :
          terrasse ombragée, chambres calmes, Wi-Fi, et une équipe joignable sans formalités.
        </p>
        <p class="mt-3 max-w-xl leading-relaxed text-foam/70">
          {hotel.address}. Depuis le centre-ville : environ 10–15 min en taxi.
        </p>
        <a href="/infos" class="mt-6 inline-block text-sm font-semibold text-sand underline-offset-4 hover:underline">
          Infos pratiques →
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="reveal mb-10">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-lagoon">Réserver</p>
      <h2 class="mt-2 text-3xl text-ocean sm:text-4xl">Trois étapes, puis WhatsApp</h2>
    </div>
    <ol class="grid gap-6 md:grid-cols-3">
      {steps.map((step) => (
        <li class="reveal rounded-2xl border border-border bg-foam p-6">
          <p class="font-display text-3xl text-terracotta">{step.n}</p>
          <h3 class="mt-3 text-xl text-ocean">{step.title}</h3>
          <p class="mt-2 leading-relaxed text-ocean/70">{step.text}</p>
        </li>
      ))}
    </ol>
    <div class="reveal mt-10 flex flex-wrap items-center gap-4">
      <WhatsAppButton label="Réserver sur WhatsApp" message={hotel.whatsappPrefill} />
      <a href="/contact" class="font-semibold text-lagoon underline-offset-4 hover:underline">
        Demande avec dates →
      </a>
    </div>
  </section>
</BaseLayout>
