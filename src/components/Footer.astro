---
import hotel from '../data/hotel.json';
---

<footer class="mt-auto bg-ocean text-foam">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="font-display text-xl text-foam">{hotel.name}</p>
        <p class="mt-2 text-sm text-foam/70">{hotel.tagline}</p>
        <p class="mt-3 text-sm text-foam/70">{hotel.address}</p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sand">Contact</p>
        <ul class="mt-3 space-y-1.5 text-sm text-foam/75">
          <li>
            <a
              class="hover:text-foam underline-offset-2 hover:underline"
              href={`https://wa.me/${hotel.whatsapp}?text=${encodeURIComponent(hotel.whatsappPrefill)}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp : {hotel.phoneDisplay}
            </a>
          </li>
          <li>
            <a class="hover:text-foam underline-offset-2 hover:underline" href={`mailto:${hotel.email}`}>
              {hotel.email}
            </a>
          </li>
          <li>{hotel.hours}</li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sand">Pages</p>
        <ul class="mt-3 space-y-1.5 text-sm text-foam/75">
          <li><a class="hover:text-foam hover:underline underline-offset-2" href="/">Accueil</a></li>
          <li><a class="hover:text-foam hover:underline underline-offset-2" href="/chambres">Chambres</a></li>
          <li><a class="hover:text-foam hover:underline underline-offset-2" href="/infos">Infos</a></li>
          <li><a class="hover:text-foam hover:underline underline-offset-2" href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 rounded-2xl border border-terracotta/45 bg-terracotta/10 px-4 py-4 text-sm text-foam">
      <p class="font-display text-base tracking-wide">DÉMONSTRATION — établissement fictif</p>
      <p class="mt-1 text-foam/80">{hotel.demoNotice}</p>
    </div>

    <p class="mt-8 text-center text-xs text-foam/40">
      © {new Date().getFullYear()} {hotel.name} — site démo pédagogique
    </p>
  </div>
</footer>
