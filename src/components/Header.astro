---
import hotel from '../data/hotel.json';

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/chambres', label: 'Chambres' },
  { href: '/infos', label: 'Infos' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/') return path === '/' || path === '';
  return path === href || path.startsWith(href + '/');
}
---

<header
  id="site-header"
  class:list={['site-header', !overlay && 'is-solid']}
  data-overlay={overlay ? 'true' : 'false'}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
    <a href="/" class="group min-w-0">
      <span class="font-display block truncate text-lg tracking-tight text-foam group-hover:text-sand sm:text-xl">
        {hotel.name}
      </span>
      <span class="hidden text-[11px] uppercase tracking-[0.18em] text-foam/60 sm:block">
        {hotel.city} · {hotel.country}
      </span>
    </a>

    <nav class="hidden md:block" aria-label="Navigation principale">
      <ul class="flex items-center gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'rounded-lg px-3 py-2 text-sm font-medium transition',
                isActive(link.href)
                  ? 'bg-white/10 text-foam'
                  : 'text-foam/70 hover:bg-white/5 hover:text-foam',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="md:hidden" aria-label="Navigation mobile">
      <ul class="flex items-center gap-0.5 text-xs font-medium">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'rounded-md px-2 py-1.5 transition',
                isActive(link.href) ? 'bg-white/10 text-foam' : 'text-foam/70',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
